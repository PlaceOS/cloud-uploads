{
    "name": "@placeos/cloud-uploads",
    "version": "0.2.4-dev",
    "description": "Signed direct to cloud uploads",
    "source": "src/index.ts",
    "main": "./dist/cloud-uploads.js",
    "module": "./dist/cloud-uploads.module.js",
    "unpkg": "./dist/cloud-uploads.umd.js",
    "typings": "dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup ./src/index.ts",
        "build-full": "tsup ./src/index.ts --sourcemap --dts",
        "dev": "microbundle watch",
        "docs": "typedoc --excludePrivate --out docs --target es6 --theme minimal --mode file src",
        "test": "jest --coverage",
        "test:watch": "jest --coverage --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --runInBand",
        "lint": "tslint",
        "semantic-release": "semantic-release",
        "prepare": "npm run build-full"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PlaceOS/cloud-uploads.git"
    },
    "author": "Alex Sorafumo",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/PlaceOS/cloud-uploads/issues"
    },
    "jest": {
        "transform": {
            ".(ts|tsx)": "ts-jest"
        },
        "testEnvironment": "jsdom",
        "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/",
            "/test/"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 50,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        },
        "collectCoverageFrom": [
            "src/**/*.{js,ts}"
        ]
    },
    "homepage": "https://github.com/PlaceOS/cloud-uploads#readme",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "jest-config": "^29.7.0",
        "rxjs": "^7.8.2",
        "ts-jest": "^29.2.6",
        "ts-md5": "^1.3.1",
        "tsup": "^8.4.0",
        "typedoc": "^0.27.9",
        "typescript": "^5.8.0"
    },
    "peerDependencies": {
        "rxjs": "^7.8.2",
        "ts-md5": "^1.3.1"
    }
}
